#!/usr/bin/env bash
# Fast subset of .github/workflows/lint.yml, run on the files being committed.
# Enable per clone with: git config core.hooksPath .githooks
# Tools come from the shared packages module.
set -euo pipefail

staged() { git diff --cached --name-only --diff-filter=ACM -- "$@"; }

mapfile -t nix_files < <(staged '*.nix')
if ((${#nix_files[@]})); then
  nixfmt "${nix_files[@]}"
  git add -- "${nix_files[@]}"
fi

mapfile -t sh_files < <(staged '*.sh')
if ((${#sh_files[@]})); then
  shellcheck -S warning "${sh_files[@]}"
fi

mapfile -t py_files < <(staged '*.py')
if ((${#py_files[@]})); then
  ruff check "${py_files[@]}"
  ruff format --check "${py_files[@]}"
fi

mapfile -t workflow_files < <(staged '.github/workflows/*.yml')
if ((${#workflow_files[@]})); then
  actionlint "${workflow_files[@]}"
fi

# Secret scan on staged changes, same config as the lint.yml backstop.
gitleaks git --staged --redact --no-banner --config .gitleaks.toml
