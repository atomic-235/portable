  "permission": {
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.config/opencode/skills/telegram/*": "deny",
      "opencode/.config/opencode/skills/telegram/*": "deny",
      "~/.local/share/opencode/strategies/**": "allow"
    },
    "external_directory": {
      "~/.local/share/opencode/strategies/**": "allow"
    },
    "bash": {
      "sops --verbose decrypt": "deny",
      "mkfs": "deny",
      "dd if=/dev/zero": "deny",
      "dd if=/dev/random": "deny",
      "> /dev/sda": "deny",
      "chmod -R 777 /": "deny",
      "chown -R": "deny",
      "with-secrets telegram": "deny",
      "with-secrets bitcoin": "deny",
      "sops decrypt": "deny",
      "sops -d": "deny",
      "sops --decrypt": "deny",
      "sops exec-env": "deny",
      "sops exec-file": "deny",
      "age -d": "deny",
      "age --decrypt": "deny",
      "gpg --decrypt": "deny",
      "gpg -d": "deny",
      "gpg2 --decrypt": "deny",
      "gpg2 -d": "deny",
      "ansible-vault decrypt": "deny",
      "ansible-vault view": "deny",
      "blackbox_decrypt": "deny",
      "transcrypt -f": "deny",
      "git-crypt unlock": "deny"
    }
  },
